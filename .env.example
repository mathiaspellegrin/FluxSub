# FluxSub — copy to .env and set only if you need overrides.
# No secrets are required for local dev; contract addresses are in f-e/src/config/contracts.ts

# Optional: override default network (testnet | mainnet | espace)
# NEXT_PUBLIC_NETWORK=espace

# Optional: custom RPC (if not using default Conflux RPCs in contracts.ts)
# NEXT_PUBLIC_RPC_URL=https://main.confluxrpc.com

# Never commit private keys or wallet secrets here.
